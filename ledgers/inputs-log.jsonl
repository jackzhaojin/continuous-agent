# Inputs Log (JSONL Format)
# Each line is a JSON object representing an input event
# Schema:
# {
#   "timestamp": "ISO8601 datetime",
#   "source": "human|system|external",
#   "type": "instruction|feedback|context|event",
#   "content": "string or object",
#   "session_id": "optional session identifier",
#   "metadata": {}
# }
