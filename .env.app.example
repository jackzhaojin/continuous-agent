# App-specific credentials (store inside each project directory)
# This is just a Node-friendly example; apps may use Docker envs,
# shell exports, iOS build settings, or other config mechanisms.
APP_DATABASE_URL=
APP_REDIS_URL=
APP_STORAGE_KEY=

# Supabase (APP_ prefix stripped when injected into projects)
APP_SUPABASE_URL=                   # https://<ref>.supabase.co
APP_SUPABASE_ANON_KEY=              # Public anon JWT
APP_SUPABASE_SERVICE_ROLE_KEY=      # Admin JWT (bypasses RLS)
APP_SUPABASE_PASSWORD=              # Database password (for direct SQL via pooler)
APP_SUPABASE_POOLER_REGION=         # Pooler region (e.g., aws-1-us-east-2) — check dashboard Connect page
