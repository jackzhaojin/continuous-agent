# Executive agent configuration (control plane)

# Agent identity
AGENT_EMAIL=                          # Agent's own email (e.g., for service registrations)
AGENT_EMAIL_PASSWORD=                 # Agent email account password (for OAuth setup only)
AGENT_DISPLAY_NAME=                   # Agent's display name (used in Discord, webhooks, etc.)

# Gmail OAuth Configuration
IDENTITY_ENABLED=true                 # Master switch for all identity features
GMAIL_ENABLED=true                    # Enable Gmail inbox checking and sending
GMAIL_CLIENT_ID=                      # OAuth client ID from Google Cloud Console
GMAIL_CLIENT_SECRET=                  # OAuth client secret
GMAIL_REFRESH_TOKEN=                  # Long-lived refresh token (from one-time OAuth flow)

# Discord Configuration
DISCORD_ENABLED=true                  # Enable Discord notifications
DISCORD_BOT_TOKEN=                    # Discord bot token
DISCORD_CHANNEL_ID=                   # Channel ID for notifications
DISCORD_DM_USER_ID=                   # Owner's Discord user ID (for DM notifications)
DISCORD_WEBHOOK_URL=                  # (Optional) Webhook URL for channel posts
DISCORD_MAX_MESSAGES_PER_HOUR=10      # Throttle limit

# Loop timing (continuous execution by default)
# Agent only sleeps when idle (no work) or unhealthy - NOT after completing work
IDLE_SLEEP_SECONDS=30               # Sleep when queue is empty (polling interval)
UNHEALTHY_SLEEP_SECONDS=60          # Sleep when system unhealthy before retrying

# Incremental execution configuration
BREAKDOWN_THRESHOLD_TURNS=100       # Trigger breakdown if estimated > 100 turns
AUTO_BREAKDOWN_ENABLED=true         # Enable automatic task breakdown
STEP_MIN_TURNS=100                  # Minimum turns per generated step
STEP_TARGET_TURNS=100               # Target turns per generated step
STEP_MAX_TURNS=150                  # Max turns per generated step
MAX_TURNS_PER_STEP=100              # Max turns per step for multi-step tasks (MINIMUM 100)

# Notion Reporting (auto-generated by scripts/setup-notion-workspace.ts)
NOTION_API_KEY=                     # Notion integration token
NOTION_DATABASE_ID=                 # Agent Milestones database ID
NOTION_MONTHLY_PAGE_ID=             # Current month's summaries page ID
NOTION_REPORTING_ENABLED=true       # Kill switch for all Notion writes
NOTION_E2E_PAGE_ID=                 # Page ID for E2E test block appends

# V3.0 Second Brain (mem0 cloud — see ai-docs/v3/2026-05-16-v3.0/2026-05-15-second-brain-hosting-decision.md)
# Executive-only. Never reaches worker agents.
V3_MEMORY_ENABLED=true              # Master switch for second-brain features
V3_MEM0_API_KEY=                    # Mem0 cloud API key (m0-... — mint at app.mem0.ai under your agent's email, not personal)
V3_MEM0_USER_ID=                    # Canonical user_id slug for all writes (your executive agent's handle; never committed)
V3_MEM0_TOP_K=10                    # Default top_k for memory-pack retrieval
V3_MEM0_CONFIDENCE_FLOOR=0.7        # Minimum memory confidence included in worker packs

# Taxonomy v1.0.0 (see .claude/skills/memory-harvester/references/taxonomy.md)
V3_MEM0_ENV=prod                    # "test" | "dev" | "prod". Stamped on every write. Reader filters default to "prod" so test writes don't leak.
V3_MEM0_COHORT=                     # Optional sub-isolation token for parallel test runs (e.g. "smoke-2026-05-16"). Leave empty in prod.

# V3.0 staged-rollout hook flags. ALL DEFAULT OFF — wired into executive-loop.ts
# but inert until flipped. Requires V3_MEMORY_ENABLED=true AND the per-hook flag.
# Activate one stage at a time, ~1 week apart, auditing each (impl plan §Staged rollout).
V3_MEM_HOOK_POST_RUN=false          # Stage 1 — Hook C: post-run harvest (write-only, lowest risk)
V3_MEM_HOOK_PRE_SPAWN=false         # Stage 2 — Hook B: pre-spawn worker memory pack (read → worker)
V3_MEM_HOOK_PRE_WORK=false          # Stage 3 — Hook A: pre-work-selection consult (read → executive)
V3_MEM_HOOK_FAIL_DIAG=false         # Stage 4 — Hook D: failure-diagnosis consult (read + conditional write)
V3_MEM_HOOK_POST_RETRO=false        # Stage 5 — Hook E: post-retro harvest (write, highest judgment)
