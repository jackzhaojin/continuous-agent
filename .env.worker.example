# ── Vendor Selection ──────────────────────────────────────────────
# WORKER_VENDOR controls which SDK spawns agentic workers:
#   'claude' (default) = Claude Agent SDK (@anthropic-ai/claude-agent-sdk)
#   'codex'            = OpenAI Codex SDK (@openai/codex-sdk)
#   'kimi'             = Kimi Wire Protocol (@moonshot-ai/kimi-agent-sdk)
#                        Bidirectional JSON-RPC 2.0, supports external tools,
#                        mid-turn steering, subagents, and session persistence
WORKER_VENDOR=claude

# CHAT_VENDOR controls which API handles simple LLM calls (breakdown, diagnosis):
#   'claude'   (default) = Claude Agent SDK (single-turn query)
#   'openai'             = OpenAI Chat Completions API
#   'moonshot'           = Kimi K2.5 via Moonshot AI (OpenAI-compatible)
#   'custom'             = Any OpenAI-compatible endpoint (set LLM_BASE_URL)
CHAT_VENDOR=claude

# ── Claude Authentication (for WORKER_VENDOR=claude / CHAT_VENDOR=claude) ──
# Option 1: OAuth token (Claude Pro/Max subscription)
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2: API key
ANTHROPIC_API_KEY=

# ── OpenAI / Codex Authentication (for WORKER_VENDOR=codex / CHAT_VENDOR=openai) ──
OPENAI_API_KEY=
# CODEX_API_KEY=                     # Falls back to OPENAI_API_KEY

# ── Moonshot AI / Kimi (for WORKER_VENDOR=kimi / CHAT_VENDOR=moonshot) ──
MOONSHOT_API_KEY=
# KIMI_MODEL=kimi-k2.5               # Model for Kimi Wire workers (default: kimi-k2.5)
# KIMI_EXECUTABLE=kimi               # Path to kimi CLI binary
# KIMI_THINKING=false                 # Enable thinking/reasoning mode
# KIMI_YOLO_MODE=true                 # Auto-approve tool calls (default: true for workers)

# ── Custom OpenAI-Compatible Endpoint (for CHAT_VENDOR=custom) ──
# LLM_BASE_URL=                      # e.g., https://api.together.xyz/v1
# LLM_API_KEY=                       # Generic fallback API key

# ── Model Selection ──────────────────────────────────────────────
MODEL=claude-sonnet-4-5              # Default model for workers (vendor-specific)
# CHAT_MODEL=                        # Override model for chat calls (breakdown, diagnosis)
# BREAKDOWN_MODEL=                   # Override model specifically for goal breakdown

# Agent configuration
MAX_TURNS=250                       # Max turns per worker session for single-step tasks (250 for complex coding)

# Third-party API keys (used by workers)
ELEVENLABS_API_KEY=                 # ElevenLabs TTS API key (for demo video skill)

# Supabase
SUPABASE_URL=                       # https://<ref>.supabase.co
SUPABASE_ANON_KEY=                  # Public anon JWT
SUPABASE_SERVICE_ROLE_KEY=          # Admin JWT (bypasses RLS)
