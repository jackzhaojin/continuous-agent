{
  "name": "continuous-executive-agent",
  "version": "2.1.4",
  "description": "Autonomous AI agent that finds and executes work",
  "main": "dist/executive-loop.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-harness-assets.mjs && node scripts/generate-build-info.mjs && (pm2 sendSignal SIGUSR2 executive-loop 2>/dev/null || true)",
    "start": "node dist/executive-loop.js",
    "dev": "tsx src/executive-loop.ts",
    "typecheck": "tsc --noEmit",
    "harness": "tsx src/harnesses/cli.ts",
    "harness:list": "tsx src/harnesses/cli.ts --list",
    "test:adhoc:v2-loaders": "tsx tests/adhoc/v2-library-loaders.adhoc.ts",
    "test:harness": "tests/adhoc/2026-04-11-harness-v22/run-all.sh",
    "test:harness:live": "RUN_LIVE_E2E=1 tsx tests/e2e/harnesses/claude-live-generic.e2e.ts",
    "test:retro-h": "tsx tests/adhoc/h1-kimi-handoff-parser.adhoc.ts && tsx tests/adhoc/h3-gate-blocks-on-regression.adhoc.ts && tsx tests/adhoc/h4-defect-recursion-depth.adhoc.ts && tsx tests/adhoc/h5-rebreakdown-preserves-completed.adhoc.ts && tsx tests/adhoc/h6-worker-log-untruncated.adhoc.ts",
    "test:retro-i": "tsx tests/adhoc/i0-prompt-builder-enrichment.adhoc.ts && tsx tests/adhoc/i1-backend-testing-skill-present.adhoc.ts && tsx tests/adhoc/i2-backend-first-breakdown.adhoc.ts && tsx tests/adhoc/i3-journey-api-verification.adhoc.ts && tsx tests/adhoc/i4-ui-library-guidance.adhoc.ts && tsx tests/adhoc/a5-playwright-policy.adhoc.ts",
    "test:retro-j": "tsx tests/adhoc/j1-no-db-goal-skips-prereq.adhoc.ts && tsx tests/adhoc/j2-web-with-db-still-gets-prereq.adhoc.ts && tsx tests/adhoc/j3-prereq-description-quotes-prompt.adhoc.ts && tsx tests/adhoc/j4-no-ui-tag-suppresses-prereq.adhoc.ts",
    "test:v2.4": "npm run test:retro-h && npm run test:retro-i && npm run test:retro-j"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.29",
    "@moonshot-ai/kimi-agent-sdk": "^0.1.6",
    "@notionhq/client": "^5.9.0",
    "@openai/codex-sdk": "^0.117.0",
    "@playwright/mcp": "^0.0.70",
    "dotenv": "^16.4.5",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.1.0",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
