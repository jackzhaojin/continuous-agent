# ═══════════════════════════════════════════════════════════════════
# CREDENTIAL TIERS
# ═══════════════════════════════════════════════════════════════════
#
# This .env file contains three tiers of credentials:
#
#   Tier 1 (EXECUTIVE)   — Keys the executive loop needs to orchestrate.
#                          Stay in the agent process. Never copied to workers.
#
#   Tier 2 (EXECUTION)   — Keys worker agents need to execute tasks.
#                          Copied to agent-outputs/.env for workers.
#
#   Tier 3 (APPLICATION) — Keys built applications need. Prefixed with APP_.
#                          Copied to project dirs as .env.app (prefix stripped).
#
# See: capabilities/credential-tiers.yml for the full registry.
# See: src/deterministic/credential-tiers.ts for the filtering logic.
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# TIER 2: EXECUTION AGENT (copied to workers)
# ───────────────────────────────────────────────────────────────────
# These keys are shared with Tier 1 (executive also needs them for
# diagnosis subagents). They are the most critical keys in the system.

# Claude Agent SDK Authentication (ONE required)
# Option 1: OAuth token (Claude Pro/Max subscription)
CLAUDE_CODE_OAUTH_TOKEN=
# Option 2: API key
ANTHROPIC_API_KEY=

# Model selection (optional, default: claude-sonnet-4-5)
MODEL=claude-sonnet-4-5

# Execution-agent-specific tool keys
ELEVENLABS_API_KEY=                 # ElevenLabs TTS API key (for demo video skill)

# Future execution agents (uncomment as needed):
# OPENAI_API_KEY=                   # For GPT-based execution agents
# GEMINI_API_KEY=                   # For Gemini-based execution agents


# ───────────────────────────────────────────────────────────────────
# TIER 1: EXECUTIVE AGENT (stays in executive process only)
# ───────────────────────────────────────────────────────────────────

# Agent configuration
MAX_TURNS=250                       # Max turns per worker session for single-step tasks
MAX_TURNS_PER_STEP=100              # Max turns per step for multi-step tasks (MINIMUM 100)

# Loop timing (continuous execution by default)
IDLE_SLEEP_SECONDS=30               # Sleep when queue is empty (polling interval)
UNHEALTHY_SLEEP_SECONDS=60          # Sleep when system unhealthy before retrying

# Incremental execution configuration
BREAKDOWN_THRESHOLD_TURNS=100       # Trigger breakdown if estimated > 100 turns
AUTO_BREAKDOWN_ENABLED=true         # Enable automatic task breakdown

# Notion Reporting (executive-only integration)
NOTION_API_KEY=                     # Notion integration token
NOTION_DATABASE_ID=                 # Agent Milestones database ID
NOTION_MONTHLY_PAGE_ID=             # Current month's summaries page ID
NOTION_REPORTING_ENABLED=true       # Kill switch for all Notion writes


# ───────────────────────────────────────────────────────────────────
# TIER 3: APPLICATION (copied to project dirs as .env.app)
# ───────────────────────────────────────────────────────────────────
# All APP_* variables are auto-detected as Tier 3.
# The APP_ prefix is stripped when written to .env.app, so apps see
# standard names (e.g., APP_DATABASE_URL → DATABASE_URL).
#
# Workers are informed which app credentials are available so they
# can configure projects accordingly.

# Databases
APP_DATABASE_URL=                   # Primary database (PostgreSQL, MySQL, etc.)
APP_MONGODB_URI=                    # MongoDB connection URI
APP_REDIS_URL=                      # Redis connection URL

# Payment
APP_STRIPE_SECRET_KEY=              # Stripe secret key
APP_STRIPE_PUBLISHABLE_KEY=         # Stripe publishable key (client-safe)

# Email
APP_SENDGRID_API_KEY=               # SendGrid API key
APP_RESEND_API_KEY=                 # Resend API key

# Cloud / Storage
APP_AWS_ACCESS_KEY_ID=              # AWS access key
APP_AWS_SECRET_ACCESS_KEY=          # AWS secret key
APP_AWS_REGION=us-east-1            # AWS region
APP_S3_BUCKET=                      # S3 bucket name

# Authentication
APP_JWT_SECRET=                     # JWT signing secret
APP_NEXTAUTH_SECRET=                # NextAuth.js secret
APP_NEXTAUTH_URL=                   # NextAuth.js URL (e.g., http://localhost:3000)

# AI/ML (keys the APP uses, distinct from execution agent keys)
APP_OPENAI_API_KEY=                 # OpenAI API key for app features
APP_ANTHROPIC_API_KEY=              # Anthropic API key for app features

# Supabase
APP_SUPABASE_URL=                   # Supabase project URL
APP_SUPABASE_ANON_KEY=              # Supabase anonymous key

# Firebase
APP_FIREBASE_PROJECT_ID=            # Firebase project ID
